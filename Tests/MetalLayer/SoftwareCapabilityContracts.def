// Minimal verified rectangular contracts for the original 24 P0 software gaps.
// Retain these software semantics when P1A adds a GPU descriptor. Binding names
// are production TVP function pointers, not
// similarly named legacy tvpgl *_c routines. Valid domains below are baseline
// fixture domains, not an assertion that every software geometry is safe.
// GAP(name, inputs, formats, parameters, reference, alpha, binding, semantics)
GAP("SubBlend", 1, "RGBA8 -> RGBA8", "opacity:0", "target; reference ignored", "preserve destination alpha", "TVPSubBlend_HDA / TVPSubBlend_HDA_o", "saturating complemented-source subtraction; opacity=255 selects full branch; source alpha ignored")
GAP("MulBlend", 1, "RGBA8 -> RGBA8", "opacity:0", "target; reference ignored", "production mul functor preserves destination alpha", "TVPMulBlend / TVPMulBlend_o", "RGB multiply with >>8; opacity branch transforms complemented source; distinct from HDA object")
GAP("MulBlend_HDA", 1, "RGBA8 -> RGBA8", "opacity:0", "target; reference ignored", "preserve destination alpha", "TVPMulBlend_HDA / TVPMulBlend_HDA_o", "HDA wrappers; distinct from MulBlend object; opacity=255 selects full branch")
GAP("ColorDodgeBlend", 1, "RGBA8 -> RGBA8", "opacity:0", "target; reference ignored", "preserve destination alpha", "TVPColorDodgeBlend_HDA / TVPColorDodgeBlend_HDA_o", "reciprocal table and saturation; opacity scales source RGB before dodge; source alpha ignored")
GAP("DarkenBlend", 1, "RGBA8 -> RGBA8", "opacity:0", "target; reference ignored", "preserve destination alpha", "TVPDarkenBlend_HDA / TVPDarkenBlend_HDA_o", "per-channel minimum; opacity interpolation uses >>8; source alpha ignored")
GAP("LightenBlend", 1, "RGBA8 -> RGBA8", "opacity:0", "target; reference ignored", "preserve destination alpha", "TVPLightenBlend_HDA / TVPLightenBlend_HDA_o", "per-channel maximum; opacity interpolation uses >>8; source alpha ignored")
GAP("ScreenBlend", 1, "RGBA8 -> RGBA8", "opacity:0", "target; reference ignored", "preserve destination alpha", "TVPScreenBlend_HDA / TVPScreenBlend_HDA_o", "complemented multiply; exact full and opacity HDA branches differ; source alpha ignored")
GAP("PsAlphaBlend", 1, "RGBA8 -> RGBA8", "opacity:0", "target; reference ignored", "preserve destination alpha", "TVPPsAlphaBlend_HDA / TVPPsAlphaBlend_HDA_o", "RGB interpolation; full branch uses source alpha; opacity branch uses (sourceAlpha*opacity)>>8")
GAP("PsAddBlend", 1, "RGBA8 -> RGBA8", "opacity:0", "target; reference ignored", "preserve destination alpha", "TVPPsAddBlend_HDA / TVPPsAddBlend_HDA_o", "saturating RGB add then Ps alpha interpolation; source alpha precedes opacity")
GAP("PsSubBlend", 1, "RGBA8 -> RGBA8", "opacity:0", "target; reference ignored", "preserve destination alpha", "TVPPsSubBlend_HDA / TVPPsSubBlend_HDA_o", "saturating RGB subtract then Ps alpha interpolation; source alpha precedes opacity")
GAP("PsSoftLightBlend", 1, "RGBA8 -> RGBA8", "opacity:0", "target; reference ignored", "preserve destination alpha", "TVPPsSoftLightBlend_HDA / TVPPsSoftLightBlend_HDA_o", "PsSoftLightTable lookup then Ps alpha interpolation; table rounding is authoritative")
GAP("PsColorDodgeBlend", 1, "RGBA8 -> RGBA8", "opacity:0", "target; reference ignored", "preserve destination alpha", "TVPPsColorDodgeBlend_HDA / TVPPsColorDodgeBlend_HDA_o", "PsColorDodgeTable lookup then Ps alpha interpolation; distinct from ColorDodge5")
GAP("PsColorBurnBlend", 1, "RGBA8 -> RGBA8", "opacity:0", "target; reference ignored", "preserve destination alpha", "TVPPsColorBurnBlend_HDA / TVPPsColorBurnBlend_HDA_o", "PsColorBurnTable lookup then Ps alpha interpolation; table rounding is authoritative")
GAP("PsLightenBlend", 1, "RGBA8 -> RGBA8", "opacity:0", "target; reference ignored", "preserve destination alpha", "TVPPsLightenBlend_HDA / TVPPsLightenBlend_HDA_o", "RGB maximum then Ps alpha interpolation; source alpha precedes opacity")
GAP("PsDarkenBlend", 1, "RGBA8 -> RGBA8", "opacity:0", "target; reference ignored", "preserve destination alpha", "TVPPsDarkenBlend_HDA / TVPPsDarkenBlend_HDA_o", "RGB minimum then Ps alpha interpolation; source alpha precedes opacity")
GAP("PsDiffBlend", 1, "RGBA8 -> RGBA8", "opacity:0", "target; reference ignored", "preserve destination alpha", "TVPPsDiffBlend_HDA / TVPPsDiffBlend_HDA_o", "absolute RGB difference then Ps alpha interpolation; source alpha precedes opacity")
GAP("PsDiff5Blend", 1, "RGBA8 -> RGBA8", "opacity:0", "target; reference ignored", "preserve destination alpha", "TVPPsDiff5Blend_HDA / TVPPsDiff5Blend_HDA_o", "source RGB is faded by effective alpha before absolute difference; distinct from PsDiff post-difference interpolation")
GAP("PsExclusionBlend", 1, "RGBA8 -> RGBA8", "opacity:0", "target; reference ignored", "preserve destination alpha", "TVPPsExclusionBlend_HDA / TVPPsExclusionBlend_HDA_o", "exclusion RGB formula then Ps alpha interpolation; source alpha precedes opacity")
GAP("RemoveOpacity", 1, "R8 mask -> RGBA8", "opacity:0", "target; reference ignored", "RGB preserved; destination alpha reduced by mask", "TVPRemoveOpacity / TVPRemoveOpacity_o", "full alpha=(destAlpha*(255-mask))>>8; opacity branch adjusts opacity above127 before mask product")
GAP("AdditiveAlphaToAlpha", 0, "reference RGBA8 -> RGBA8", "", "copy reference rectangle before conversion", "copy reference alpha; RGB unpremultiply via TVPDivTable", "TVPConvertAdditiveAlphaToAlpha", "ApplySelf first calls DirectCopy; reference required for zero-input LayerBitmap call")
GAP("AdjustGamma", 0, "RGBA8 target", "gammaAdjustData:0", "signature accepts reference, implementation reads target directly", "preserve target alpha; RGB straight-alpha LUT", "TVPAdjustGamma", "SetParameterPtr copies values into owned TVPInitGammaAdjustTempData LUT; no retained caller pointer")
GAP("AdjustGamma_a", 0, "RGBA8 target", "gammaAdjustData:0", "signature accepts reference, implementation reads target directly", "preserve target alpha; additive/premultiplied RGB LUT", "TVPAdjustGamma_a", "owned LUT; opaque/transparent/partial-alpha branches; reciprocal-derived LUT indices clamp255 independently for RGB; over-alpha RGB excess handled separately")
GAP("AlphaBlend_SD", 1, "RGBA8 -> RGBA8", "opacity:0", "target used as first SD source; reference ignored", "RGB interpolation; bound const_alpha_blend_functor returns alpha zero", "TVPConstAlphaBlend_SD", "BltWithOpa_SD calls Func(dst,dst,src,w,opacity); opacity always used, no full branch; not two-input")
GAP("ConstAlphaBlend_SD_a", 2, "RGBA8 + RGBA8 -> RGBA8", "opacity:0", "two explicit sources; reference ignored", "blend_argb interpolates full ARGB", "TVPConstAlphaBlend_SD_a", "TransBlt passes input0 then input1; independent object and function from ConstAlphaBlend_SD; opacity always used")
