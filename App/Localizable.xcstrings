    "Library version %lld isn’t supported. Please update the app." : {
      "comment" : "Shown by VNCore; the package resolves strings against the app's catalog.",
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライブラリのバージョン %lld には対応していません。アプリをアップデートしてください。"
          }
        },
        "zh-Hans" : {
