    "Couldn’t switch the audio session, so the game will stay muted: %@" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オーディオセッションを切り替えられなかったため、ゲームはミュートのままになります：%@"
