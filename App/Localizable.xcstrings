    "Couldn’t get the current iOS window, so KRKR wasn’t started." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在の iOS ウインドウを取得できなかったため、KRKR を起動しませんでした。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法取得当前 iOS 窗口，KRKR 未启动。"
          }
        }
      }
    },
    "Couldn’t read the library: %@\nThe original file was kept at Application Support/Mikage/library-v2.json. Pull down to refresh and try again." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライブラリを読み込めませんでした：%@\n元のファイルは Application Support/Mikage/library-v2.json に残っています。下に引いて更新すると再試行できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取游戏库：%@\n原文件已保留在 Application Support/Mikage/library-v2.json。下拉刷新可重试。"
          }
        }
      }
    },
    "Couldn’t recognize “%@”. Choose the engine it uses." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」を自動で認識できませんでした。使用しているエンジンを選択してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未能自动识别“%@”，请选择它所属的引擎。"
          }
        }
      }
    },
