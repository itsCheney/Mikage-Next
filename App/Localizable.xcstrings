    "%@ and %lld more · Keep the saves, free %@" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ほか %2$lld 本 · セーブは残して %3$@ 解放"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 等 %2$lld 部 · 保留存档，释放 %3$@"
          }
        }
      }
    },
    "%@ didn’t accept the token. Check it in Settings › Accounts & Sync." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ がトークンを受け付けませんでした。「設定 › アカウントと同期」で確認してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 未接受此令牌，请在“设置 › 账号与同步”中检查。"
          }
        }
      }
    },
    "%@ in total" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "合計 %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "累计 %@"
          }
        }
      }
    },
    "%@ is busy. Try again in a minute." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ が混み合っています。少し待ってからもう一度お試しください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 正忙，请稍后再试。"
          }
        }
      }
    },
    "%@ left of %@ on this %@" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この %3$@ は %2$@ 中 %1$@ の空き"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%3$@ 共 %2$@，还剩 %1$@"
          }
        }
      }
    },
    "%@ returned error %lld." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
