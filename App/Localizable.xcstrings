    "The fetched cover and details are removed. Your status and rating stay on this device and in your lists." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取得したカバーと作品情報を削除します。ステータスと評価はこの端末とリストに残ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "获取的封面和资料会被移除。你的状态和评分仍保留在本机和你的收藏中。"
          }
        }
      }
    },
    "The game file path is outside the allowed folder." : {
      "comment" : "Shown by VNCore; the package resolves strings against the app's catalog.",
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゲームファイルのパスが許可されたフォルダの外にあります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "游戏文件路径超出了允许的目录。"
          }
        }
      }
    },
    "The game folder contains symbolic links, which can’t be imported yet." : {
      "comment" : "Shown by VNCore; the package resolves strings against the app's catalog.",
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
