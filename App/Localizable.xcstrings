    },
    "Long-press a game card to open this page. Only the KiriKiri engine has a runtime so far; a recognized engine doesn’t mean compatibility has been verified." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゲームカードを長押しするとこのページを開けます。現在ランタイムがあるのは KiriKiri エンジンのみです。エンジンを認識しても、互換性が確認されたわけではありません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "长按游戏卡片可打开此页面。只有 KiriKiri 引擎已接入运行时；引擎识别不代表已经验证兼容性。"
          }
        }
      }
    },
    "Main thread %.1f ms · peak %.1f ms" : {
