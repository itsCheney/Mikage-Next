    "A cover you set yourself is never replaced." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分で設定したカバーが上書きされることはありません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手动设置的封面永远不会被覆盖。"
          }
        }
      }
    },
    "A KRKR game is already running." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KRKR ゲームはすでに実行中です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已有 KRKR 游戏正在运行。"
          }
        }
      }
    },
    "A line about it (optional)" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "感想をひとこと（任意）"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写一句感想（可选）"
          }
        }
      }
    },
    "A new Emote playback method for comparing motion smoothness. Off by default. Takes effect the next time a game launches; if motions or expressions look wrong, turn it off and reopen the game." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "動きの滑らかさを比較するための新しい Emote 再生方式です。デフォルトはオフです。次回ゲームを起動したときに反映されます。動きや表情に異常がある場合は、オフにしてゲームを開き直してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新的 Emote 播放方式，用于对比动作流畅度，默认关闭。下次启动游戏时生效；若动作或表情异常，可关闭后重新进入游戏。"
          }
        }
      }
    },
