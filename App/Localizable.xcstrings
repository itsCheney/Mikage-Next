          }
        }
      }
    },
    "Link the folder again or delete the record" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォルダを再リンクするか、記録を削除"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重新关联文件夹，或删除记录"
          }
        }
      }
    },
    "Link this game to Bangumi or VNDB to show its cover, synopsis and tags, and to sync your status and rating to your lists." : {
      "localizations" : {
        "ja" : {
