+void normalizedTouchToGame(float pX, float pY, int& gameX, int& gameY)
+{
+    int drawableWidth = 1, drawableHeight = 1;
+    SDL_GetWindowSizeInPixels(tvp_window, &drawableWidth, &drawableHeight);
+    drawableWidth = std::max(drawableWidth, 1);
+    drawableHeight = std::max(drawableHeight, 1);
+    float pixelX = pX * drawableWidth;
+    float pixelY = pY * drawableHeight;
+    TVPSprite* sprite = krkrsdl3::KRKR_Get_Current_Sprite();
+    if (!sprite || sprite->width <= 0 || sprite->height <= 0)
+    {
+        gameX = static_cast<int>(pixelX);
+        gameY = static_cast<int>(pixelY);
+        return;
+    }
+    float scale = std::min(static_cast<float>(drawableWidth) / sprite->width,
+                           static_cast<float>(drawableHeight) / sprite->height);
+    float offsetX = (drawableWidth - sprite->width * scale) * 0.5f;
+    float offsetY = (drawableHeight - sprite->height * scale) * 0.5f;
+    gameX = static_cast<int>((pixelX - offsetX) / scale);
+    gameY = static_cast<int>((pixelY - offsetY) / scale);
+    gameX = std::max(0, std::min(gameX, sprite->width - 1));
+    gameY = std::max(0, std::min(gameY, sprite->height - 1));
+}
